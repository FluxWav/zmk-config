# Right side is central (for Procyon trackpad support)
if SHIELD_wav50hz_RIGHT

config ZMK_KEYBOARD_NAME
    default "Wav50hz"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

# Procyon 42x50mm trackpad dimensions
# Logical resolution (touch points) - approximate based on mXT336UD sensor
config ZMK_TRACKPAD_LOGICAL_X
    default 1050

config ZMK_TRACKPAD_LOGICAL_Y
    default 1250

# Physical size in 0.1mm units (42mm x 50mm)
config ZMK_TRACKPAD_PHYSICAL_X
    default 420

config ZMK_TRACKPAD_PHYSICAL_Y
    default 500

endif # SHIELD_wav50hz_RIGHT

if SHIELD_wav50hz_LEFT || SHIELD_wav50hz_RIGHT

config ZMK_SPLIT
    default y

config SPI
    default y

config I2C
    default y

config ZMK_RGB_UNDERGLOW
    select WS2812_STRIP
    select SPI

endif # SHIELD_wav50hz_LEFT || SHIELD_wav50hz_RIGHT
