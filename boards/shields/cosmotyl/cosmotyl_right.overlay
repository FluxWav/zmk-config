#include "cosmotyl.dtsi"

/ {
    bootloader_key: bootloader_key {
        compatible = "zmk,boot-magic-key";
        key-position = <29>;
        jump-to-bootloader;
    };
};

&default_transform {
    col-offset = <7>;
};

// Enable I2C for Procyon trackpad via VIK connector
// Use &i2c0 directly since vik_i2c alias is defined in board overlay processed later
&i2c0 {
    status = "okay";

    trackpad: maxtouch@4a {
        compatible = "microchip,maxtouch";
        status = "okay";
        reg = <0x4a>;
        // CHG pin on VIK AD_1 = P0.29 on Cosmos Lemon Wireless
        chg-gpios = <&gpio0 29 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

        // Procyon 42x50 dimensions (in millimeters)
        sensor-width = <42>;
        sensor-height = <50>;

        // Orientation
        swap-xy;
        // invert-x;  // Uncomment if X axis is reversed
        // invert-y;  // Uncomment if Y axis is reversed

        // TUNED: Reduced thresholds for more sensitivity
        touch_threshold = <12>;      // was 18 - lower = more sensitive
        touch_hysteresis = <5>;      // was 8 - lower = faster response

        // TUNED: Increased gain for stronger signal
        gain = <8>;                  // default 4 - higher = more sensitive

        // TUNED: Faster acquisition for smoother tracking
        active-acq-time-ms = <6>;    // default 10 - faster updates
        idle-acq-time-ms = <20>;     // default 32 - faster idle scanning

        repeat-each-cycle;
    };
};

/ {
    trackpad_listener {
        compatible = "zmk,input-listener";
        mode = "trackpad";
        device = <&trackpad>;
    };
};
